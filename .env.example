# Copy to .env for local dev, and add the same keys in Vercel → Settings → Environment Variables.

# MongoDB Atlas connection string (include database name, e.g. /couponchrome)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/couponchrome?retryWrites=true&w=majority&appName=Cluster0"

# Any long random string (required in production on Vercel)
AUTH_SECRET="replace-with-a-long-random-secret"
